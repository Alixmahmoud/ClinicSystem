root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csproj,props,targets,json}]
indent_size = 4

[*.{xaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.sln]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.editorconfig]
end_of_line = lf